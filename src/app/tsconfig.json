{
	"compilerOptions": {
		"paths": {
			"@/*": ["./*"]
		},
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"jsx": "react-jsx",
		"types": ["vite/client"]
	},
	"include": ["."],
	"exclude": ["node_modules", "dist"]
}
