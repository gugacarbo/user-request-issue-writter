{
	"name": "user-request-issue-writer",
	"version": "1.0.0",
	"description": "Webhook server that turns GitHub issue comments into issues via an LLM with function calling.",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build:server": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external",
		"start": "node dist/index.js",
		"test": "vitest run --coverage",
		"test:e2e": "node --env-file=.env node_modules/vitest/vitest.mjs run src/tests/e2e.test.ts src/tests/github.e2e.test.ts",
		"test:watch": "vitest",
		"lint": "biome check",
		"format": "biome check --write",
		"typecheck": "tsc && tsc -p src/app/tsconfig.json",
		"knip": "knip",
		"prepare": "husky",
		"docs-check": "python3 scripts/docs-check",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"app:dev": "vite",
		"app:build": "vite build",
		"app:typecheck": "tsc -p src/app/tsconfig.json",
		"build": "pnpm app:build && pnpm build:server"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"packageManager": "pnpm@11.0.9",
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.4",
		"@vitest/coverage-v8": "^4.1.10",
		"drizzle-kit": "^0.31.10",
		"esbuild": "^0.28.1",
		"husky": "^9.1.7",
		"knip": "^6.29.0",
		"lint-staged": "^17.1.1",
		"prettier": "^3.9.6",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tsc-files": "^1.1.4",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@fastify/sse": "^0.5.0",
		"@fastify/static": "^10.1.2",
		"@fontsource-variable/geist": "^5.3.0",
		"@pierre/diffs": "^1.2.12",
		"@streamdown/code": "^1.1.1",
		"@t3-oss/env-core": "^0.13.11",
		"@tabler/icons-react": "^3.45.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-virtual": "^3.14.8",
		"ai": "^7.0.37",
		"better-sqlite3": "^13.0.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"fastify": "^5.10.0",
		"lottie-react": "^2.4.1",
		"lucide-react": "^1.27.0",
		"next-themes": "^0.4.6",
		"openai": "^6.48.0",
		"radix-ui": "^1.6.7",
		"shadcn": "^4.15.0",
		"streamdown": "^2.5.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	}
}
