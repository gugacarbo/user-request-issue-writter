{
	"name": "user-request-issue-writter",
	"version": "1.0.0",
	"description": "Webhook server that turns GitHub issue comments into issues via an LLM with function calling.",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc",
		"start": "node dist/index.js",
		"test": "vitest run",
		"test:e2e": "node --env-file=.env node_modules/vitest/vitest.mjs run tests/e2e.test.ts tests/github.e2e.test.ts",
		"test:watch": "vitest",
		"lint": "biome check",
		"format": "biome check --write",
		"typecheck": "tsc --noEmit",
		"knip": "knip",
		"prepare": "husky",
		"docs-check": "python3 scripts/docs-check"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^11.0.9",
			"onFail": "download"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@types/node": "^26.1.1",
		"husky": "^9.1.7",
		"knip": "^6.29.0",
		"lint-staged": "^17.1.1",
		"prettier": "^3.9.6",
		"tsc-files": "^1.1.4",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@t3-oss/env-core": "^0.13.11",
		"fastify": "^5.10.0",
		"openai": "^6.48.0",
		"zod": "^4.4.3"
	}
}
